{
  "expo": {
    "name": "ReciclaSpot",
    "slug": "ReciclaSpot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reciclaspot",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.reciclaspot.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ReciclaSpot precisa acessar sua localização para mostrar os ecopontos mais próximos no mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O ReciclaSpot precisa acessar a câmera para registrar a foto comprovante do descarte consciente e atualizar seu perfil."
        }
      ],
      "expo-sqlite",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
